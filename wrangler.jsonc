{
  "name": "donation-middleware",
  "main": "index.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "FIBERY_ACCOUNT": "fosswiki"
  },
  "routes": [
    {
      "pattern": "donationwebhook.foss.wiki",
      "zone_name": "foss.wiki",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ]
}
